	"TELL_FROZE": {"zh_CN": "你突然站住了。盲人不会无缘无故停下。", "en": "You stopped dead. A blind man doesn't stop for nothing."},
	"TELL_PHANTOM": {"zh_CN": "你朝一个不存在的声音转过了头。", "en": "You turned towards a sound that was never there."},
	"TELL_EYES": {"zh_CN": "你一直在看他的眼睛。", "en": "You kept looking him in the eye."},
	"THINK_CORPSE": {"zh_CN": "她就躺在那儿。别看。别停。", "en": "She is lying right there. Don't look. Don't stop."},
