	"OBJ_PIANO": {"zh_CN": "走进客厅（左手边的门），在钢琴前坐下", "en": "Go into the living room (the door on the left) and sit at the piano"},
	"HINT_ENTER": {"zh_CN": "你什么都没看见。绕开她，别盯着看，别出声。走到钢琴前坐下。", "en": "You saw nothing. Go round her, don't stare, don't make a sound. Walk to the piano and sit."},
	"HINT_UNREAL": {"zh_CN": "从现在起，你会看见、听见不存在的东西。他看不见它们——他只看你的反应。", "en": "From now on you will see and hear things that are not there. He can't see them. He only watches how you react."},
	"MIC_LABEL": {"zh_CN": "麦克风", "en": "MIC"},
	"TELL_FLINCH": {"zh_CN": "你的头猛地动了一下。", "en": "Your head jerked."},
	"TELL_STARE": {"zh_CN": "你盯着它看。", "en": "You stared at it."},
	"TELL_FUMBLE": {"zh_CN": "你被吓到后，琴声乱了。", "en": "After the scare, your playing fell apart."},
	"TELL_SLIP": {"zh_CN": "弹错了一个音。", "en": "A wrong note."},
