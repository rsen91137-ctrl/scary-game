	"FRAME_FOOTPRINTS": {"zh_CN": "血地上留下了你的鞋印。", "en": "Your footprints in the blood."},
	"FRAME_WIRE": {"zh_CN": "琴弦上留下了你的指纹。", "en": "Your prints on the piano string."},
	# ---- the backstory, told over the eye before the night begins
